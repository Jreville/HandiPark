# Copier ce fichier en .env et renseigner les valeurs
# cp .env.example .env
# NE JAMAIS commiter .env

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=remplacer_par_une_chaine_aleatoire_32_caracteres
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Adapter user/password/dbname selon votre environnement
# Docker : host = "database" (nom du service docker-compose)
# Local   : host = 127.0.0.1
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/handipark?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# Dev local : autoriser tous les ports localhost
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
# Production : remplacer par le domaine réel
# CORS_ALLOW_ORIGIN='^https://handipark\.re$'
###< nelmio/cors-bundle ###
